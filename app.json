{
  "expo": {
    "name": "PhraseUNO",
    "slug": "phraseuno",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.phraseuno.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#173e32",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": true,
      "package": "com.phraseuno.mobile"
    },
    "plugins": [
      "expo-router",
      [
        "expo-localization",
        {
          "supportedLocales": [
            "de",
            "en"
          ],
          "supportsRTL": false
        }
      ],
      [
        "expo-notifications",
        {
          "enableRemoteNotifications": false
        }
      ]
    ],
    "scheme": "phraseuno",
    "platforms": [
      "ios",
      "android"
    ]
  }
}
